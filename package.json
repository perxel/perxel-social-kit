{
  "name": "@perxel/social-kit",
  "version": "0.1.0",
  "description": "One post, every size: social images and reels, and the images a site's blog posts need, from React templates your project owns.",
  "license": "MIT",
  "author": "Perxel (https://perxel.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perxel/perxel-social-kit.git"
  },
  "homepage": "https://github.com/perxel/perxel-social-kit#readme",
  "bugs": "https://github.com/perxel/perxel-social-kit/issues",
  "keywords": [
    "social media",
    "open graph",
    "images",
    "reels",
    "video",
    "react",
    "remotion",
    "puppeteer",
    "agent skill"
  ],
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "bin": {
    "social-kit": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "skill",
    "python"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "example": "cd examples && node ../dist/cli/index.js",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "jiti": "2.7.0",
    "puppeteer-core": "25.13.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "remotion": ">=4",
    "@remotion/bundler": ">=4",
    "@remotion/renderer": ">=4",
    "@remotion/tailwind-v4": ">=4"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/tailwind-v4": "4.0.534",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "typescript": "6.0.3"
  },
  "peerDependenciesMeta": {
    "remotion": {
      "optional": true
    },
    "@remotion/bundler": {
      "optional": true
    },
    "@remotion/renderer": {
      "optional": true
    },
    "@remotion/tailwind-v4": {
      "optional": true
    }
  }
}
